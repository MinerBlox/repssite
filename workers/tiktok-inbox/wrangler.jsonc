{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repscentral-tiktok-inbox",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": { "FIREBASE_PROJECT_ID": "reps-central" },
  "r2_buckets": [
    { "binding": "VIDEO_MEDIA_BUCKET", "bucket_name": "replace-with-private-video-bucket-name" }
  ]
}
